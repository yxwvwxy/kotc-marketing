# Branch Dashboard login (used by Playwright browser export)
BRANCH_EMAIL=you@example.com
BRANCH_PASSWORD=your_branch_password

# Optional but recommended: full URL of ANALYSIS → Overview for
# app "MCAT: King of the curve" (copy from browser address bar).
BRANCH_SUMMARY_URL=

# Show the browser window while exporting (1=yes, 0=headless). Useful for first setup.
BRANCH_HEADED=0

# Legacy Query API credentials (not used by browser sync; safe to leave blank)
BRANCH_KEY=
BRANCH_SECRET=

# GCP service account JSON path (local). In GitHub Actions use secret GCP_SA_KEY instead.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json

BQ_PROJECT_ID=kotc-dashboard-auto-update
BQ_DATASET=branch
BQ_TABLE=daily_campaign_metrics

# How many days to re-pull each run (matches Branch CTI window). Default 7.
SYNC_LOOKBACK_DAYS=7

# IANA timezone for "yesterday"
SYNC_TIMEZONE=America/New_York
