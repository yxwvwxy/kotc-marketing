# Meta Marketing API
META_ACCESS_TOKEN=your_long_lived_user_or_system_token

# Defaults to act_972808873202575 — override only if needed
# META_AD_ACCOUNT_ID=act_972808873202575

# Slack Incoming Webhook — https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX

# Optional: only check these campaign IDs (faster). Leave unset to auto-discover
# all OUTCOME_APP_PROMOTION campaigns (report shows spend > 0 only).
# META_CAMPAIGN_IDS=23855562694380330

# Optional: override report date for testing (YYYY-MM-DD or MM/DD/YYYY)
# REPORT_DATE=2026-06-01
